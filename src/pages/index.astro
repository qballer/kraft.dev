---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { links, site } from '../site.config';

const goals = [
  ['Agentic SDLC', 'How AI agents change every step of the software lifecycle: planning, coding, review, testing and shipping.'],
  ['Dark factories', 'Lights-out software production, where agents build, test and ship with few humans in the loop.'],
  ['Agents in the product', 'Shipping agents as product features: architecture, evals, UX, reliability and cost.'],
  ['Where craft still matters', 'Which hard engineering skills still count, and how we grow engineers when AI writes most of the code.'],
] as const;

const agenda = [
  ['17:00', 'Doors open, food, drinks & mingling'],
  ['17:45', 'Talks: Ariel Kaspit, Benjamin Gruenbaum, Doron Tsur'],
  ['19:25', 'Sufganiyot and mingling'],
  ['20:00', 'Wrap-up'],
] as const;

const talks = [
  {
    speaker: 'Ariel Kaspit',
    role: 'AIOps Engineer, HiBob',
    title: 'Who Runs The Factory?',
  },
  {
    speaker: 'Doron Tsur',
    url: 'https://yay.dev/',
    title: 'Turning Lights in the Dark: Harness Engineering, Verification & Missing Evidence Layer',
  },
  {
    speaker: 'Benjamin Gruenbaum',
    role: 'Founding developer at Eon, Node.js core maintainer',
    title: 'Graph Engineering in Reverse',
  },
];

const venue = 'HiBob offices, Derech Menachem Begin 148, Tel Aviv';
const mapUrl = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent('HiBob, Derech Menachem Begin 148, Tel Aviv');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: 'Kraft Dev #1: Engineering Craft in the Age of AI Agents',
  startDate: '2026-12-09T17:00:00+02:00',
  endDate: '2026-12-09T20:00:00+02:00',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  isAccessibleForFree: true,
  location: {
    '@type': 'Place',
    name: 'HiBob',
    address: 'Derech Menachem Begin 148, Tel Aviv, Israel',
  },
  organizer: { '@type': 'Organization', name: site.name, url: site.url },
  ...(links.luma ? { url: links.luma } : {}),
};
---

<Base jsonLd={jsonLd}>
  <header class="top wrap">
    <a href="/" aria-label="Kraft Dev, home"><Logo /></a>
    {links.luma && <a class="top-cta" href={links.luma}>Register</a>}
  </header>

  <main>
    <section class="hero wrap">
      <p class="label">Monthly meetup · Tel Aviv · In person</p>
      <h1>Engineering craft in the age of AI&nbsp;agents.</h1>
      <p class="lede">
        Kraft Dev is a monthly in-person meetup in Tel Aviv for engineers, engineering leaders and product
        builders.
      </p>
    </section>

    <section class="wrap block" aria-labelledby="goals-h">
      <h2 id="goals-h">What we talk about</h2>
      <ol class="goals">
        {
          goals.map(([title, text], i) => (
            <li>
              <span class="label">0{i + 1}</span>
              <h3>{title}</h3>
              <p>{text}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="wrap block" id="meetup-1" aria-labelledby="m1-h">
      <p class="label">Meetup #1</p>
      <h2 id="m1-h">Wednesday 9 December 2026</h2>
      <p class="when">6th night of Hanukkah · <a href={mapUrl}>{venue}</a></p>

      <div class="event">
        <ul class="agenda">
          {
            agenda.map(([time, item]) => (
              <li>
                <span class="time">{time}</span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
        <div class="register">
          <p><strong>Free, limited spots.</strong> Registration requires approval.</p>
          {
            links.luma ? (
              <a class="btn" href={links.luma}>Register on Luma</a>
            ) : (
              <span class="btn btn--soon" aria-disabled="true">Registration opens soon</span>
            )
          }
        </div>
      </div>

      <h3 class="talks-h">Speakers</h3>
      <ul class="talks">
        {
          talks.map((t) => (
            <li>
              <p class="speaker">
                {t.url ? <a href={t.url}>{t.speaker}</a> : t.speaker}
                {t.role && <span class="role"> · {t.role}</span>}
              </p>
              <h4>{t.title}</h4>
            </li>
          ))
        }
      </ul>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap foot-in">
      <p>
        {
          links.whatsapp ? (
            <a href={links.whatsapp}>Join the Kraft Dev WhatsApp community</a>
          ) : (
            <span>WhatsApp community: link coming soon</span>
          )
        }
      </p>
      <p class="muted">Meetup #1 is hosted by HiBob · kraft.dev</p>
    </div>
  </footer>
</Base>

<style>
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.25rem;
    --logo-h: 30px;
  }
  .top a {
    text-decoration: none;
  }
  .top-cta {
    font: 600 0.9rem/1 var(--sans);
    padding: 0.6em 1em;
    border: 1.5px solid var(--ink);
    border-radius: var(--radius);
  }
  .top-cta:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .hero {
    padding-block: clamp(2.5rem, 9vw, 6rem) clamp(2rem, 6vw, 4rem);
  }
  .hero h1 {
    max-width: 16ch;
  }
  .lede {
    font-size: clamp(1.1rem, 2.2vw, 1.3rem);
    color: var(--ink-2);
    max-width: 44ch;
  }
  .block {
    padding-block: clamp(2rem, 6vw, 3.5rem);
    border-block-start: 1px solid var(--line);
  }
  .goals {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 1rem;
  }
  .goals li {
    padding: 1.1rem 1.2rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .goals li:first-child {
    border-block-start: 3px solid var(--accent);
  }
  .goals h3 {
    margin: 0.4rem 0;
  }
  .goals p {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.97rem;
  }
  .when {
    color: var(--ink-2);
    font-size: 1.1rem;
  }
  .event {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem 2.5rem;
    align-items: start;
    margin-block: 1.75rem 2.5rem;
  }
  @media (max-width: 700px) {
    .event {
      grid-template-columns: 1fr;
    }
  }
  .agenda {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .agenda li {
    display: flex;
    gap: 1rem;
    padding-block: 0.55rem;
    border-block-end: 1px dashed var(--line);
  }
  .time {
    font-family: var(--mono);
    color: var(--accent);
    min-inline-size: 3.5rem;
  }
  .register {
    padding: 1.25rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .btn--soon {
    background: transparent;
    color: var(--ink-2);
    border: 1.5px dashed var(--ink-2);
  }
  .talks-h {
    font-size: 1.4rem;
  }
  .talks {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .talks li {
    padding: 1.2rem 1.3rem;
    border: 1px solid var(--line);
    border-inline-start: 3px solid var(--accent);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .speaker {
    margin: 0 0 0.3rem;
    font-weight: 650;
  }
  .role {
    font-weight: 400;
    color: var(--ink-2);
  }
  .talks h4 {
    margin: 0 0 0.4rem;
    font-size: 1.15rem;
    line-height: 1.3;
  }
  .foot {
    margin-block-start: 2rem;
    padding-block: 2rem;
    border-block-start: 1px solid var(--line);
  }
  .foot-in {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
  }
  .foot p {
    margin: 0;
  }
  .muted {
    color: var(--ink-2);
  }
</style>
