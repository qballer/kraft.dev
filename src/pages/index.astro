---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { joinFormEndpoint, joinFormFields, links, site } from '../site.config';

const goals = [
  ['Agentic SDLC', 'How AI agents change every step of the software lifecycle: planning, coding, review, testing and shipping.'],
  ['Dark factories', 'Lights-out software production, where agents build, test and ship with few humans in the loop.'],
  ['Agents in the product', 'Shipping agents as product features: architecture, evals, UX, reliability and cost.'],
  ['Where Kraft still matters', 'Which hard engineering skills still count, and how we grow engineers when AI writes most of the code.'],
] as const;

const agenda = [
  ['17:00', 'Doors open, food, drinks & mingling'],
  ['17:45', 'Talk: Ariel Kaspit'],
  ['18:20', 'Talk: Doron Tsur'],
  ['18:55', 'Talk: Benjamin Gruenbaum'],
  ['19:25', 'Wrap-up'],
] as const;

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

const talks = [
  {
    time: '17:45',
    speaker: 'Ariel Kaspit',
    role: 'AIOps Engineer, HiBob',
    title: 'Who Runs The Factory?',
    photo: `${base}speakers/ariel.jpg`,
    url: 'https://www.linkedin.com/in/ariel-kaspit-79b908196/',
    site: 'LinkedIn',
  },
  {
    time: '18:20',
    speaker: 'Doron Tsur',
    role: 'Platform & Distributed Systems Architect',
    title: 'Turning Lights in the Dark: Harness Engineering, Verification & Missing Evidence Layer',
    photo: `${base}speakers/doron.jpg`,
    url: 'https://www.linkedin.com/in/doron-tsur',
    site: 'LinkedIn',
  },
  {
    time: '18:55',
    speaker: 'Benjamin Gruenbaum',
    role: 'Founding developer at Eon, Node.js core maintainer',
    title: 'Graph Engineering in Reverse',
    photo: `${base}speakers/benji.jpg`,
    url: 'https://github.com/benjamingr',
    site: 'GitHub',
  },
];

const fields = [
  { name: 'fullName', label: 'Full name', type: 'text', autocomplete: 'name', wide: true },
  { name: 'company', label: 'Company', type: 'text', autocomplete: 'organization' },
  { name: 'role', label: 'Role', type: 'text', autocomplete: 'organization-title' },
  { name: 'email', label: 'Email', type: 'email', autocomplete: 'email', inputmode: 'email' },
  { name: 'phone', label: 'Phone number', type: 'tel', autocomplete: 'tel', inputmode: 'tel', hint: 'For the WhatsApp invite, e.g. +972 50 123 4567' },
] as const;

const venue = 'HiBob offices, Derech Menachem Begin 148, Tel Aviv';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: 'Kraft Dev #1: Engineering Kraft in the Age of AI Agents',
  startDate: '2026-12-09T17:00:00+02:00',
  endDate: '2026-12-09T20:00:00+02:00',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  isAccessibleForFree: true,
  location: {
    '@type': 'Place',
    name: 'HiBob',
    address: 'Derech Menachem Begin 148, Tel Aviv, Israel',
  },
  organizer: { '@type': 'Organization', name: site.name, url: site.url },
  ...(links.luma ? { url: links.luma } : {}),
};
---

<Base jsonLd={jsonLd}>
  <header class="top wrap">
    <a href={base} aria-label="Kraft Dev, home"><Logo /></a>
    <a class="top-cta" href="#join">Join the community</a>
  </header>

  <main>
    <section class="hero wrap">
      <p class="label">Monthly meetup · Tel Aviv · In person</p>
      <h1>Engineering Kraft in the age of AI&nbsp;agents.</h1>
      <p class="lede">
        Kraft Dev is a monthly in-person meetup in Tel Aviv for engineers, engineering leaders and product
        builders.
      </p>
      <a class="btn" href="#join">Join the WhatsApp community</a>
    </section>

    <section class="wrap block" aria-labelledby="goals-h">
      <h2 id="goals-h">What we talk about</h2>
      <ol class="goals">
        {
          goals.map(([title, text], i) => (
            <li>
              <span class="label">0{i + 1}</span>
              <h3>{title}</h3>
              <p>{text}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="wrap block" id="meetup-1" aria-labelledby="m1-h">
      <p class="label">Meetup #1</p>
      <h2 id="m1-h">Wednesday 9 December 2026</h2>
      <p class="when">17:00–20:00 · 6th night of Hanukkah · HiBob, Tel Aviv</p>

      <div class="event">
        <ul class="agenda">
          {
            agenda.map(([time, item]) => (
              <li>
                <span class="time">{time}</span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
        <dl class="facts">
          <div><dt>When</dt><dd>Wednesday 9 December 2026, 17:00–20:00</dd></div>
          <div><dt>Where</dt><dd>{venue}</dd></div>
          <div><dt>Entry</dt><dd>Free, limited spots, approval required</dd></div>
        </dl>
        {links.luma && <p class="register"><a class="btn" href={links.luma}>Register on Luma</a></p>}
      </div>

      <h3 class="talks-h">Speakers</h3>
      <ul class="talks">
        {
          talks.map((t) => (
            <li>
              <div class="who">
                <img src={t.photo} alt="" width="400" height="400" loading="lazy" decoding="async" />
                <div>
                  <p class="speaker">{t.speaker}</p>
                  <p class="role">{t.role}</p>
                </div>
              </div>
              <div>
                <p class="slot">{t.time}</p>
                <h4>{t.title}</h4>
              </div>
              <a class="profile" href={t.url} rel="noopener" aria-label={`${t.speaker} on ${t.site}`}>
                {t.site} <span aria-hidden="true">↗</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="wrap block join" id="join" aria-labelledby="join-h">
      <div class="join-intro">
        <p class="label">Community</p>
        <h2 id="join-h">Join the WhatsApp community</h2>
        <p>Get meetup announcements, talk calls and the conversation between meetups.</p>
        <p class="privacy">We use these details only to manage the Kraft Dev community.</p>
      </div>

      <div class="join-box">
        <form
          id="join-form"
          class="join-form"
          action={joinFormEndpoint || undefined}
          method="post"
          data-endpoint={joinFormEndpoint}
          data-fields={JSON.stringify(joinFormFields)}
        >
          {
            fields.map((f) => (
              <div class:list={['field', { 'field--wide': 'wide' in f && f.wide }]}>
                <label for={`f-${f.name}`}>{f.label}</label>
                {'hint' in f && <p class="hint" id={`f-${f.name}-hint`}>{f.hint}</p>}
                <input
                  id={`f-${f.name}`}
                  name={f.name}
                  type={f.type}
                  autocomplete={f.autocomplete}
                  inputmode={'inputmode' in f ? f.inputmode : undefined}
                  required
                  aria-describedby={`${'hint' in f ? `f-${f.name}-hint ` : ''}f-${f.name}-err`}
                />
                <p class="err" id={`f-${f.name}-err`} />
              </div>
            ))
          }
          <div class="field--wide submit-row">
            <button class="btn" type="submit" disabled={!joinFormEndpoint} aria-describedby="join-note">
              Join the community
            </button>
            <p class="note" id="join-note">
              {joinFormEndpoint ? 'All fields are required.' : 'Coming soon: sign-ups open shortly.'}
            </p>
          </div>
          <p class="form-err field--wide" id="join-form-err" role="alert" />
        </form>
        <p class="thanks" id="join-thanks" role="status" tabindex="-1" hidden>
          Thanks! We'll send you the WhatsApp invite.
        </p>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap foot-in">
      <p class="muted">Kraft Dev · Monthly meetup in Tel Aviv</p>
    </div>
  </footer>
</Base>

<script>
  const form = document.getElementById('join-form') as HTMLFormElement | null;
  const thanks = document.getElementById('join-thanks');
  const formErr = document.getElementById('join-form-err');
  const endpoint = form?.dataset.endpoint ?? '';

  const required: Record<string, string> = {
    fullName: 'Please enter your full name.',
    company: 'Please enter your company.',
    role: 'Please enter your role.',
    email: 'Please enter your email.',
    phone: 'Please enter your phone number.',
  };

  function problem(input: HTMLInputElement): string {
    const v = input.value.trim();
    if (!v) return required[input.name] ?? 'This field is required.';
    if (input.name === 'email' && (input.validity.typeMismatch || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v)))
      return 'Please enter a valid email, like name@company.com.';
    if (input.name === 'phone') {
      const digits = v.replace(/\D/g, '').length;
      if (!/^\+?[\d\s\-().]+$/.test(v) || digits < 7 || digits > 15)
        return 'Please enter a valid phone number, like +972 50 123 4567.';
    }
    return '';
  }

  function check(input: HTMLInputElement): boolean {
    const msg = problem(input);
    const err = document.getElementById(`${input.id}-err`);
    if (err) err.textContent = msg;
    if (msg) input.setAttribute('aria-invalid', 'true');
    else input.removeAttribute('aria-invalid');
    return !msg;
  }

  if (form) {
    // JS takes over validation; without JS the browser's native `required` checks still apply.
    form.noValidate = true;
    const inputs = Array.from(form.querySelectorAll('input'));

    for (const input of inputs) {
      input.addEventListener('blur', () => {
        if (input.value.trim() || input.dataset.touched) check(input);
        input.dataset.touched = '1';
      });
      input.addEventListener('input', () => {
        if (input.getAttribute('aria-invalid')) check(input);
      });
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (formErr) formErr.textContent = '';
      const bad = inputs.filter((i) => !check(i));
      if (bad.length) {
        bad[0].focus();
        return;
      }
      if (!endpoint) return;

      const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const label = button.textContent;
      button.disabled = true;
      button.textContent = 'Sending…';
      const fields: Record<string, string> = JSON.parse(form.dataset.fields || '{}');
      const body = new URLSearchParams();
      for (const i of inputs) body.append(fields[i.name] ?? i.name, i.value.trim());

      try {
        // Google Forms doesn't send CORS headers, so the response is opaque; a network error still throws.
        await fetch(endpoint, { method: 'POST', mode: 'no-cors', body });
        form.hidden = true;
        if (thanks) {
          thanks.hidden = false;
          ((window as any).dataLayer ||= []).push({ event: 'join_community' });
          thanks.focus();
        }
      } catch {
        if (formErr) formErr.textContent = 'Something went wrong. Please try again in a moment.';
        button.disabled = false;
        button.textContent = label;
      }
    });
  }
</script>

<style>
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.25rem;
    --logo-h: 30px;
  }
  .top a {
    text-decoration: none;
  }
  .top-cta {
    font: 600 0.9rem/1 var(--sans);
    padding: 0.6em 1em;
    border: 1.5px solid var(--ink);
    border-radius: var(--radius);
    white-space: nowrap;
  }
  .top-cta:hover {
    border-color: var(--accent);
  }
  .hero {
    padding-block: clamp(2.5rem, 9vw, 6rem) clamp(2rem, 6vw, 4rem);
  }
  .hero h1 {
    max-width: 16ch;
  }
  .lede {
    font-size: clamp(1.1rem, 2.2vw, 1.3rem);
    color: var(--ink-2);
    max-width: 44ch;
    margin-block-end: 1.75rem;
  }
  .block {
    padding-block: clamp(2rem, 6vw, 3.5rem);
    border-block-start: 1px solid var(--line);
  }
  .goals {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 1rem;
  }
  .goals li {
    padding: 1.1rem 1.2rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .goals li:first-child {
    border-block-start: 3px solid var(--accent);
  }
  .goals h3 {
    margin: 0.4rem 0;
  }
  .goals p {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.97rem;
  }
  .when {
    color: var(--ink-2);
    font-size: 1.1rem;
  }
  .event {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem 2.5rem;
    align-items: start;
    margin-block: 1.75rem 2.5rem;
  }
  @media (max-width: 700px) {
    .event {
      grid-template-columns: 1fr;
    }
  }
  .agenda {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .agenda li {
    display: flex;
    gap: 1rem;
    padding-block: 0.55rem;
    border-block-end: 1px dashed var(--line);
  }
  .time {
    font-family: var(--mono);
    color: var(--accent-text);
    min-inline-size: 3.5rem;
  }
  .register {
    margin: 1.25rem 0 0;
  }
  .facts {
    margin: 0;
    padding: 0.4rem 1.25rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .facts div {
    padding-block: 0.75rem;
  }
  .facts div + div {
    border-block-start: 1px solid var(--line);
  }
  .facts dt {
    font: 500 0.75rem/1.4 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .facts dd {
    margin: 0.15rem 0 0;
  }
  .talks-h {
    font-size: 1.4rem;
  }
  .talks {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }
  .talks li {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.3rem;
    border: 1px solid var(--line);
    border-block-start: 3px solid var(--accent);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .who {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }
  .who img {
    flex: none;
    inline-size: 72px;
    block-size: 72px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--line);
  }
  .speaker {
    margin: 0;
    font-weight: 650;
    line-height: 1.3;
  }
  .role {
    margin: 0.15rem 0 0;
    color: var(--ink-2);
    font-size: 0.92rem;
    line-height: 1.35;
  }
  .talks h4 {
    margin: 0;
    font-size: 1.15rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .slot {
    margin: 0 0 0.25rem;
    font: 500 0.85rem/1.4 var(--mono);
    color: var(--accent-text);
  }
  .profile {
    margin-block-start: auto;
    align-self: flex-start;
    font: 500 0.85rem/1.4 var(--mono);
    color: var(--accent-text);
    text-decoration: none;
  }
  .profile:hover {
    text-decoration: underline;
  }
  .join {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 1.5rem 3rem;
    align-items: start;
  }
  @media (max-width: 800px) {
    .join {
      grid-template-columns: 1fr;
    }
  }
  .join-intro p:not(.label) {
    color: var(--ink-2);
    max-width: 38ch;
  }
  .privacy {
    font-size: 0.9rem;
  }
  .join-box {
    padding: clamp(1.25rem, 3vw, 1.75rem);
    background: var(--surface);
    border: 1px solid var(--line);
    border-block-start: 3px solid var(--accent);
    border-radius: var(--radius);
  }
  .join-form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem 1rem;
  }
  @media (max-width: 520px) {
    .join-form {
      grid-template-columns: 1fr;
    }
  }
  .field--wide {
    grid-column: 1 / -1;
  }
  .field {
    display: flex;
    flex-direction: column;
    min-inline-size: 0;
  }
  .field label {
    font-weight: 600;
    font-size: 0.95rem;
    margin-block-end: 0.35rem;
  }
  .hint {
    order: 2;
    margin: 0.35rem 0 0;
    font-size: 0.85rem;
    color: var(--ink-2);
  }
  .field input {
    font: inherit;
    font-size: 1rem;
    min-block-size: 48px;
    padding: 0.6rem 0.8rem;
    color: var(--ink);
    background: var(--paper);
    border: 1.5px solid var(--line);
    border-radius: var(--radius);
    inline-size: 100%;
  }
  .field input:hover {
    border-color: var(--ink-2);
  }
  .field input:focus-visible {
    outline: 3px solid var(--accent-text);
    outline-offset: 1px;
    border-color: var(--ink);
  }
  .field input[aria-invalid='true'] {
    border-color: var(--danger);
  }
  .err {
    order: 3;
    margin: 0;
    font-size: 0.875rem;
    color: var(--danger);
  }
  .err:not(:empty) {
    margin-block-start: 0.35rem;
  }
  .submit-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-block-start: 0.5rem;
  }
  .note {
    margin: 0;
    font-size: 0.9rem;
    color: var(--ink-2);
  }
  .form-err {
    margin: 0;
    color: var(--danger);
  }
  .form-err:empty {
    display: none;
  }
  .thanks {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 600;
  }
  .thanks:focus {
    outline: none;
  }
  .foot {
    margin-block-start: 2rem;
    padding-block: 2rem;
    border-block-start: 1px solid var(--line);
  }
  .foot-in {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
  }
  .foot p {
    margin: 0;
  }
  .muted {
    color: var(--ink-2);
  }
</style>
